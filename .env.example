# Copy to .env and fill in real values before running:
#   docker compose pull && docker compose up -d
# Do not commit the real .env file.

# Harbor registry / image tags to deploy
HARBOR_HOST=reg.vittapcode.id.vn
HARBOR_PROJECT=kma-news
BACKEND_TAG=dev
FRONTEND_TAG=dev
BACKEND_PORT=1337
FRONTEND_PORT=3000

# --- Backend (Strapi) ---
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
CORS_ORIGIN=https://your-frontend-domain

# Postgres — already running elsewhere; point at it, do not start it here
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=
DATABASE_SSL=false

# MinIO (S3-compatible) — already running elsewhere. Leave AWS_BUCKET empty
# to fall back to local-disk storage (backend/config/plugins.ts).
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_FORCE_PATH_STYLE=true

# --- Frontend (Next.js) ---
# Server-only, no NEXT_PUBLIC_ prefix — should match the API_ENDPOINT
# build-arg kma-news-frontend's CI used for the image currently deployed
# (see docker-compose.yml comment). NEXT_PUBLIC_APP_URL is the one value
# still baked into the frontend image at CI build time and cannot be
# changed here.
API_ENDPOINT=
# Shared between backend and frontend (docker-compose.yml passes this same
# value to both) — backend's on-demand revalidation POST (src/index.ts) is
# authenticated with it, frontend's /api/revalidate route checks it. NOT a
# NEXT_PUBLIC_* var.
REVALIDATE_SECRET=
# Server-only — real MinIO/S3 origin+bucket (e.g. https://minio.example.edu.vn/strapi-uploads).
# Must match AWS_ENDPOINT+AWS_BUCKET above. Never sent to the browser — see
# frontend/src/app/media/[...path]/route.ts. Leave unset when AWS_BUCKET
# above is also unset (storage=local).
MEDIA_ORIGIN=
